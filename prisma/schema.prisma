generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId            String   @id
  guildName          String?
  prefix             String   @default("!")
  recruitmentEnabled  Boolean  @default(true)
  eventsEnabled      Boolean  @default(true)
  loggingEnabled     Boolean  @default(true)
  restoreRolesOnJoin Boolean  @default(true)
  // Event defaults for memorizing choices
  defaultEventChannelId String?
  defaultVoiceChannelId String?
  defaultMentionRoleId  String?
  statsApiKey           String?  // API key for external stats integrations
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model MemberInviteTracking {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  inviteCode String?
  inviterId  String?
  inviterTag String?
  joinedAt   DateTime @default(now())

  @@unique([guildId, userId])
}

model RolePermission {
  id                 String   @id @default(cuid())
  guildId            String
  roleId             String
  roleName           String?
  // Bitwise / individual permission flags
  manageSettings     Boolean  @default(false)
  manageRecruiting   Boolean  @default(false)
  manageEvents       Boolean  @default(false)
  viewLogs           Boolean  @default(false)
  manageAcademy      Boolean  @default(false)
  manageVoiceTracker Boolean  @default(false)
  antiNukeAlerts     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([guildId, roleId])
}

model RecruitmentConfig {
  guildId            String   @id
  channelId          String?  // Channel where "Apply" button is posted
  messageId          String?  // ID of the bot announcement message with the button
  categoryId         String?  // Category where private ticket channels are created
  logChannelId       String?  // Channel where transcripts are stored
  memberRoleId       String?  // Role granted upon approval
  recruiterRoleIds   String   @default("[]") // JSON array of role IDs allowed to review
  // Questions configuration stored as JSON array:
  // [{ id: 'q1', label: 'Имя и Фамилия', placeholder: 'John Doe', required: true, style: 'SHORT' }, ...]
  questionsJson      String   @default("[]")
  welcomeMessage     String   @default("Добро пожаловать в заявку! Ожидайте ответа рекрутера.")
  rejectionMessage   String   @default("К сожалению, вы не прошли собеседование.")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RecruitmentApplication {
  id               String   @id @default(cuid())
  guildId          String
  userId           String
  userTag          String?
  channelId        String?  // Private ticket channel ID
  status           String   @default("PENDING") // PENDING, UNDER_REVIEW, ACCEPTED, REJECTED
  recruiterId      String?
  recruiterTag     String?
  rejectionReason  String?
  answersJson      String   @default("{}") // Key-value answers
  transcriptUrl    String?  // Log link or message ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  closedAt         DateTime?
}

model EventGathering {
  id                String   @id @default(cuid())
  guildId           String
  title             String
  description       String?
  type              String   // UNLIMITED, LIMITED
  checkInTime       DateTime // Время проверки явки
  eventTime         DateTime // Время начала мероприятия
  partyCode         String?  // Код группы
  voiceChannelId    String?  // Голосовой канал для сбора
  channelId         String?  // Канал, где висит анонс
  messageId         String?  // Сообщение анонса
  targetRoleId      String?  // Роль для пинга
  participantLimit  Int?     // Лимит участников для LIMITED
  status            String   @default("ACTIVE") // ACTIVE, FINISHED, CANCELLED
  pingIntervalsJson String   @default("[5, 3, 1]") // Минуты до начала для пингов
  lastPingSentAt    DateTime?
  createdById       String
  createdByTag      String?
  finishedAt        DateTime?
  messageDeleted    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  participants      EventParticipant[]
}

model EventParticipant {
  id           String         @id @default(cuid())
  eventId      String
  userId       String
  userTag      String?
  status       String         @default("CONFIRMED") // CONFIRMED, RESERVE
  joinedAt     DateTime       @default(now())

  event        EventGathering @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model LoggingConfig {
  guildId              String   @id
  categoryId           String?  // Category named "LOGS"
  messageLogsChannelId String?  // #msg-logs
  memberLogsChannelId  String?  // #member-logs
  roleLogsChannelId    String?  // #role-logs
  channelLogsChannelId String?  // #channel-logs
  voiceLogsChannelId   String?  // #voice-logs
  inviteLogsChannelId  String?  // #invite-logs
  botLogsChannelId     String?  // #bot-actions-logs
  eventLogsChannelId   String?  // #ивенты-лог
  // Toggles for individual log types (stored as JSON array or boolean flags)
  enabledLogTypesJson  String   @default("[\"MESSAGES\",\"MEMBERS\",\"ROLES\",\"CHANNELS\",\"VOICE\",\"INVITES\",\"BOT\",\"EVENTS\"]")
  logSentMessages      Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SavedMemberRoles {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  userTag   String?
  nickname  String?
  rolesJson String   @default("[]") // Array of role IDs
  leftAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
}

model BotMessagesConfig {
  guildId             String   @id
  welcomeEnabled      Boolean  @default(false)
  welcomeChannelId    String?
  welcomeTitle        String   @default("Добро пожаловать в семью, {user}!")
  welcomeMessage      String   @default("Рады приветствовать тебя на нашем сервере {guild}! Ознакомься с правилами и подай заявку в семью.")
  welcomeEmbedColor   String   @default("#EC4899")

  leaveEnabled        Boolean  @default(false)
  leaveChannelId      String?
  leaveMessage        String   @default("{user} покинул наш сервер.")

  ticketGreetingTitle String   @default("Заявка в семью INTERPOL")
  ticketGreetingDesc  String   @default("Приветствуем, {user}!\nВаша анкета получена. Ожидайте рассмотрения рекрутерами семьи.\nНе забудьте подготовить скриншоты статистики.")

  botStatusText       String   @default("Majestic RP • /event")
  botStatusActivity   String   @default("PLAYING")

  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model CustomEmbedTemplate {
  id              String    @id @default(cuid())
  guildId         String
  name            String    // Template name, e.g. "Правила", "Анонс дропа"
  targetChannelId String?
  content         String?   // Text above embed (e.g. @everyone)
  title           String?
  description     String?
  color           String    @default("#EC4899")
  authorName      String?
  authorIconUrl   String?
  authorUrl       String?
  thumbnailUrl    String?
  imageUrl        String?
  footerText      String?
  footerIconUrl   String?
  fieldsJson      String    @default("[]") // JSON array of { name, value, inline }
  sentMessageId   String?
  lastSentAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// V2 EXTENSIONS: USER PROFILES & STATICS
// ==========================================

model UserProfile {
  id              String    @id @default(cuid())
  guildId         String
  userId          String    // Discord user ID
  userTag         String?
  staticId        String?   // Majestic RP Static ID (e.g. 12345)
  characterName   String?   // In-game name
  rank            Int       @default(1) // 1: Академик, 2: Участник, 3: Офицер, etc.
  mpCount         Int       @default(0) // Total verified MPs played
  penaltyMp       Int       @default(0) // Additional penalty MPs required before rankup
  voiceSeconds    Int       @default(0) // Total time spent in MP voice channels
  status          String    @default("ACTIVE") // ACTIVE, ON_LEAVE, AFK, BLACKLISTED
  leaveUntil      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mpReports       MpReport[]
  academyChannels AcademyChannel[]
  leaveRequests   LeaveRequest[]

  @@unique([guildId, userId])
  @@index([staticId])
}

// ==========================================
// V2 EXTENSIONS: ACADEMY & 2ND RANK PROMOTION
// ==========================================

model AcademyConfig {
  guildId              String   @id
  categoryId           String?  // Category for active academy channels
  archiveCategoryId    String?  // Category for archived channels
  academicRoleId       String?  // Rank 1 role ID
  promotedRoleId       String?  // Rank 2 role ID
  requiredMpForRankUp  Int      @default(10) // Default 10 MPs
  channelPrefix        String   @default("академик-")
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model AcademyChannel {
  id              String      @id @default(cuid())
  guildId         String
  userId          String
  userTag         String?
  staticId        String?
  channelId       String      @unique // Discord text channel ID
  status          String      @default("ACTIVE") // ACTIVE, PROMOTED, ARCHIVED
  approvedMpCount Int         @default(0)
  requiredMp      Int         @default(10)
  penaltyMp       Int         @default(0)
  promotedById    String?
  promotedByTag   String?
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userProfile     UserProfile? @relation(fields: [guildId, userId], references: [guildId, userId])
  reports         MpReport[]
}

model MpReport {
  id               String          @id @default(cuid())
  guildId          String
  userId           String
  userTag          String?
  academyChannelId String?
  channelId        String          // Channel where report was posted
  messageId        String?         // Discord embed message with Approve/Reject buttons
  mpType           String          // Дроп, Цех, ВЗМ, МЦЛ, Капт, etc.
  screenshotUrls   String          @default("[]") // JSON array of screenshot URLs
  comment          String?
  status           String          @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewerId       String?
  reviewerTag      String?
  rejectionReason  String?
  createdAt        DateTime        @default(now())
  reviewedAt       DateTime?

  userProfile      UserProfile?    @relation(fields: [guildId, userId], references: [guildId, userId])
  academyChannel   AcademyChannel? @relation(fields: [academyChannelId], references: [id])
}

// ==========================================
// V2 EXTENSIONS: DYNAMIC VOICE MP TRACKER
// ==========================================

model VoiceTrackerConfig {
  guildId              String   @id
  voiceChannelId       String?  // Tracked voice channel ID
  defaultVoiceName     String   @default("Ожидание МП")
  controlChannelId     String?  // Channel for staff MP start/stop control panel
  controlMessageId     String?  // Persistent control message
  logChannelId         String?  // Log channel for attendance summaries
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model VoiceTrackerSession {
  id               String               @id @default(cuid())
  guildId          String
  eventName        String               // e.g. "Дроп [16:00]"
  voiceChannelId   String
  startedById      String
  startedByTag     String?
  startedAt        DateTime             @default(now())
  endedAt          DateTime?
  status           String               @default("ACTIVE") // ACTIVE, COMPLETED
  totalAttendees   Int                  @default(0)
  peakConcurrent   Int                  @default(0)
  attendanceJson   String               @default("[]") // [{ userId, userTag, joinTime, leaveTime, durationSeconds, isLate, leftEarly }]
  
  attendanceLogs   VoiceAttendanceLog[]
}

model VoiceAttendanceLog {
  id              String              @id @default(cuid())
  sessionId       String
  guildId         String
  userId          String
  userTag         String?
  joinedAt        DateTime
  leftAt          DateTime?
  durationSeconds Int                 @default(0)
  isLate          Boolean             @default(false)
  leftEarly       Boolean             @default(false)

  session         VoiceTrackerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ==========================================
// V2 EXTENSIONS: LEAVES & AFK
// ==========================================

model LeaveRequest {
  id              String       @id @default(cuid())
  guildId         String
  userId          String
  userTag         String?
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          String       @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewerId      String?
  reviewerTag     String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  reviewedAt      DateTime?

  userProfile     UserProfile? @relation(fields: [guildId, userId], references: [guildId, userId])
}

// ==========================================
// V2 EXTENSIONS: RECRUITER PAYROLL & BONUSES
// ==========================================

model RecruiterSalaryConfig {
  guildId                  String   @id
  payPerCandidateAccepted  Float    @default(10000) // $10,000 per accepted recruit
  payPerCandidateRejected  Float    @default(3000)  // $3,000 per rejected recruit
  payPerApprovedReport     Float    @default(3000)  // $3,000 per approved MP report
  payPerRejectedReport     Float    @default(1500)  // $1,500 per reviewed but rejected MP report
  payPerPromotion          Float    @default(15000) // $15,000 per completed academician promotion
  currencySymbol           String   @default("$")
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())
}

model RecruiterPayoutRecord {
  id                      String   @id @default(cuid())
  guildId                 String
  recruiterId             String
  recruiterTag            String?
  periodStart             DateTime
  periodEnd               DateTime
  acceptedCount           Int      @default(0)
  rejectedCandidatesCount Int      @default(0)
  reportsCount            Int      @default(0)
  rejectedReportsCount    Int      @default(0)
  promotionsCount         Int      @default(0)
  totalPayout             Float    @default(0)
  status                  String   @default("PENDING") // PENDING, PAID
  paidAt                  DateTime?
  paidById                String?
  notes                   String?
  createdAt               DateTime @default(now())
}

// ==========================================
// V2 EXTENSIONS: BLACKLIST (ЧС)
// ==========================================

model BlacklistEntry {
  id         String   @id @default(cuid())
  guildId    String
  staticId   String?  // Majestic Static ID
  discordId  String?  // Discord User ID
  name       String?  // In-game name or Discord Tag
  reason     String
  proofUrl   String?  // Link to proof screenshot/video
  addedById  String
  addedByTag String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([staticId])
  @@index([discordId])
}

// ==========================================
// V2 EXTENSIONS: ANTI-NUKE & SERVER BACKUPS
// ==========================================

model AntiNukeConfig {
  guildId              String   @id
  enabled              Boolean  @default(true)
  actionOnChannelDelete String  @default("STRIP_ROLES_RESTORE") // STRIP_ROLES_RESTORE, KICK, BAN
  alertUserIdsJson     String   @default("[]") // Array of Leader/Dep Discord IDs to DM
  alertChannelId       String?  // Channel to send emergency alert
  autoBackupDaily      Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model ServerBackupSnapshot {
  id          String   @id @default(cuid())
  guildId     String
  name        String   // e.g. "Auto Backup 23.09.2026", "Before Raid"
  createdById String?
  createdByTag String?
  dataJson    String   // Full JSON tree of categories, channels, permissions, roles
  channelsCount Int    @default(0)
  rolesCount    Int    @default(0)
  createdAt   DateTime @default(now())
}


