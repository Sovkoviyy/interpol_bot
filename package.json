{
  "name": "interpol_bot",
  "version": "6.0.0",
  "description": "Modular Discord bot and Web Dashboard for Majestic RP Family",
  "main": "dist/index.js",
  "scripts": {
    "start": "node start.js",
    "setup": "node start.js --setup-only",
    "dev": "tsx src/index.ts",
    "build:server": "prisma generate && tsc",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:server && npm run build:web",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss",
    "db:check": "node scripts/migrate-helper.js check",
    "db:sync": "node scripts/migrate-helper.js sync",
    "db:fix": "node scripts/migrate-helper.js fix",
    "vps:export": "node scripts/migrate-helper.js export",
    "vps:import": "node scripts/migrate-helper.js import"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4"
  }
}
